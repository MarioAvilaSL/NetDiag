# Normaliza los finales de línea para que los diffs no cambien según quién clone.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.json text eol=lf

# El lanzador de Gradle es un script de shell y el de Windows necesita CRLF.
gradlew text eol=lf
*.bat text eol=crlf

# Binarios: nunca tocar.
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary